PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-secret-in-production

# Leave DB_DIALECT=sqlite for local file storage (no MySQL required).
# For MySQL or TiDB Cloud, switch dialect and fill in credentials.
DB_DIALECT=sqlite
# DB_STORAGE=./data/kihindi.sqlite

# MySQL / TiDB
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=kihindi_sacco
# DB_SSL=false
