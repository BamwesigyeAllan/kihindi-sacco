PORT=5000
NODE_ENV=development
JWT_SECRET=local-development-only-change-before-production
UPLOAD_DIR=./uploads

# Leave DB_DIALECT=sqlite for local file storage (no MySQL required).
# For MySQL or TiDB Cloud, switch dialect and fill in credentials.
DB_DIALECT=sqlite
# DB_STORAGE=./data/kihindi.sqlite

# PostgreSQL (Render or another managed PostgreSQL provider)
# NODE_ENV=production
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:password@host:5432/database
# DB_SSL=true
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=set-a-unique-password-here

# MySQL / TiDB
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=kihindi_sacco
# DB_SSL=false
